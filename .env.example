# Gunakan Internal Connection URL PostgreSQL dari environment Easypanel yang sama.
DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_SERVICE:5432/DATABASE?sslmode=disable
PORT=3000
PGPOOL_MAX=10

# API Key untuk melindungi endpoint (opsional tapi direkomendasikan)
# Jika tidak di-set, endpoint bisa diakses tanpa autentikasi.
# Kirim sebagai header: X-API-Key: <nilai>
API_KEY=

# SMTP untuk mengirim kode reset password via email (wajib agar fitur "Lupa Password" berfungsi)
# Contoh Gmail: host smtp.gmail.com, port 587, gunakan App Password (bukan password akun biasa)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
