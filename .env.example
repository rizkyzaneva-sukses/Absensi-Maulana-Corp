# Gunakan Internal Connection URL PostgreSQL dari environment Easypanel yang sama.
DATABASE_URL=postgresql://USER:***@POSTGRES_SERVICE:5432/DATABASE?sslmode=disable
PORT=3000
PGPOOL_MAX=10

# API Key untuk melindungi endpoint (opsional tapi direkomendasikan)
# Jika tidak di-set, endpoint bisa diakses tanpa autentikasi.
# Kirim sebagai header: X-API-Key: <nilai>
API_KEY=

# Batasi origin yang boleh akses API (opsional). Kosongkan jika frontend & API
# disajikan dari domain yang sama (default deployment container ini).
ALLOWED_ORIGIN=

# Telegram Bot Token untuk fitur "Connect Telegram" & reset password via Telegram
# Buat bot via @BotFather di Telegram, lalu paste token-nya di sini.
# Setelah diisi, daftarkan webhook sekali:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<DOMAIN>/api/telegram/webhook"
TELEGRAM_BOT_TOKEN=
