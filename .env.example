# Gunakan Internal Connection URL PostgreSQL dari environment Easypanel yang sama.
DATABASE_URL=postgresql://USER:***@POSTGRES_SERVICE:5432/DATABASE?sslmode=disable
PORT=3000
PGPOOL_MAX=10

# API Key untuk melindungi endpoint (opsional tapi direkomendasikan)
# Jika tidak di-set, endpoint bisa diakses tanpa autentikasi.
# Kirim sebagai header: X-API-Key: <nilai>
API_KEY=

# Telegram Bot Token untuk mengirim kode reset password via Telegram
# Buat bot via @BotFather di Telegram, lalu paste token-nya di sini
TELEGRAM_BOT_TOKEN=
